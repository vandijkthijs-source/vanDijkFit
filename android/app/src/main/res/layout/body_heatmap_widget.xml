<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_card_background"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="MUSCLES TRAINED"
      android:textColor="#4DA4FF"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty_message"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="#8F98A5"
    android:textSize="12sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <FrameLayout
      android:layout_width="122dp"
      android:layout_height="match_parent"
      android:layout_gravity="center_horizontal">

      <ImageView
        android:id="@+id/widget_body_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/front_man_widget" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_side_toggle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_toggle_button_background"
      android:clickable="true"
      android:focusable="true"
      android:paddingLeft="12dp"
      android:paddingTop="8dp"
      android:paddingRight="12dp"
      android:paddingBottom="8dp"
      android:text="SHOW BACK"
      android:textColor="#F47F8A"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
